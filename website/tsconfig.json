{
  // This file is not used in compilation. It is here just for a nice editor experience.
  // Inlined from @docusaurus/tsconfig@3.10.2 minus `baseUrl`: TypeScript 7 removed the
  // option (TS5102) and the upstream preset still sets it. Without `baseUrl`, `paths`
  // resolve relative to this file — the same "." the preset intended. Re-extend the
  // preset once it ships TS7-compatible.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "exclude": [".docusaurus", "build"]
}
